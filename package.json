{
  "name": "minimal-personal-blog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "profile:refresh": "tsx scripts/generate-public-profiles.ts",
    "comments:scan": "tsx scripts/check-public-secrets.ts",
    "comments:sync-targets": "tsx scripts/sync-comment-targets.ts",
    "comments:db-reset": "supabase db reset",
    "comments:test-db": "supabase test db",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:node": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test": "pnpm test:unit && pnpm test:node",
    "test:content": "node --test tests/content-schema.test.mjs",
    "test:build": "node --test tests/production-build.test.mjs",
    "test:security": "node --test --test-concurrency=1 tests/talk-sanitization.test.mjs tests/comments-security.test.mjs",
    "test:post-security": "node --test tests/post-markdown-safety.test.mjs",
    "test:drafts": "node --test tests/draft-publication.test.mjs",
    "test:url-audit": "node --test tests/external-url-audit.test.mjs",
    "test:timezone": "node --test tests/timezone-date.test.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.2",
    "@astrojs/react": "^6.0.4",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/svelte": "^8.1.2",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "astro": "^6.4.2",
    "katex": "^0.17.0",
    "markdown-it": "^14.1.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-type-animation": "^3.2.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.13.0",
    "svelte": "^5.56.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "supabase": "2.116.0",
    "tailwindcss": "^4.1.14",
    "tsx": "4.20.5",
    "typescript": "~5.8.2"
  }
}
