---
import Layout from '../layouts/Layout.astro';
import { portalConfig } from '../config/portal';
import { getPublishedKnowledge, getPublishedProjects, getPublishedUpdates } from '../utils/portalCollections';
const [knowledge, projects, updates] = await Promise.all([getPublishedKnowledge(), getPublishedProjects(), getPublishedUpdates()]);
const dates = [
  ...knowledge.map((entry) => entry.data.updated.toISOString().slice(0, 10)),
  ...projects.map((entry) => entry.data.updated.toISOString().slice(0, 10)),
  ...updates.map((entry) => entry.data.published.toISOString().slice(0, 10)),
  ...portalConfig.projects.map((project) => project.updated),
].sort((a, b) => b.localeCompare(a));
const lastUpdated = dates[0] ?? '';
---

<Layout title="现在" description="SunTBurst 当前公开关注方向">
  <div class="mx-auto grid max-w-5xl gap-6">
    <section class="border-4 border-[#d97706] bg-[#fffbeb] p-5 shadow-[7px_7px_0_0_#d97706] dark:bg-amber-950/40 sm:p-8">
      <p class="text-xs font-black tracking-[0.16em] text-amber-700 dark:text-amber-300">NOW</p>
      <h1 class="mt-1 text-3xl font-black text-amber-900 dark:text-amber-100">现在正在关注</h1>
      <p class="mt-3 font-bold leading-7 text-slate-700 dark:text-slate-200">这不是长期承诺清单，而是目前公开工作重心的短快照。内容更新至 <strong>{lastUpdated}</strong>。</p>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2">{portalConfig.focus.map((item) => <li data-current-focus class="border-2 border-amber-700 bg-white p-4 font-bold leading-7 dark:bg-slate-800">{item}</li>)}</ul>
    </section>

    <section class="border-4 border-[#0284c7] bg-white p-5 shadow-[7px_7px_0_0_#0284c7] dark:bg-slate-800 sm:p-8">
      <p class="text-xs font-black tracking-[0.16em] text-[#0369a1] dark:text-[#bae6fd]">ROADMAP</p>
      <h2 class="mt-1 text-2xl font-black text-[#075985] dark:text-[#bae6fd]">从现在走向下一步</h2>
      <ol class="mt-5 grid gap-4 lg:grid-cols-3">
        {portalConfig.roadmap.map((item) => {
          const stateLabel = item.state === 'completed' ? '已完成' : item.state === 'configuration' ? '需要配置' : '后续计划';
          return (
            <li data-roadmap-item={item.state} class="min-w-0 border-3 border-[#0284c7] bg-[#f8fafc] p-4 dark:bg-slate-900">
              <span class:list={['inline-flex border-2 px-2 py-1 text-xs font-black', item.state === 'completed' ? 'border-emerald-700 bg-emerald-100 text-emerald-800' : item.state === 'configuration' ? 'border-amber-700 bg-amber-100 text-amber-800' : 'border-slate-500 bg-slate-100 text-slate-700']}>{stateLabel}</span>
              <h3 class="mt-3 text-lg font-black text-[#075985] dark:text-[#bae6fd]">{item.title}</h3>
              <p class="mt-2 text-sm font-bold leading-6 text-slate-700 dark:text-slate-200">{item.description}</p>
              <a href={item.href} class="mt-4 inline-flex min-h-[44px] items-center font-black text-[#075985] underline decoration-2 underline-offset-4 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#0ea5e9]/40 dark:text-[#bae6fd]">查看依据与边界 →</a>
            </li>
          );
        })}
      </ol>
    </section>
  </div>
</Layout>
