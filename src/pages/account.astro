---
import Layout from '../layouts/Layout.astro';
import CmsAccountPage from 'virtual:cms-account';
import CmsSetupState from '../components/cms/CmsSetupState.svelte';
import { cmsEnvironment, readCmsConnection, readCmsSiteUrl } from '../features/cms/config';
import type { CmsConnection } from '../features/cms/types';

let connection: CmsConnection | null = null;
let setupError = '';
const environment = cmsEnvironment();
try { connection = readCmsConnection(environment); } catch (error) { setupError = error instanceof Error ? error.message : 'CMS 配置无效'; }
const cmsSiteUrl = connection ? null : readCmsSiteUrl(environment);
---

<Layout title="账户中心" description="使用 GitHub 登录并查看本站账户状态" hidePageBanner robots="noindex,nofollow">
  {connection ? <CmsAccountPage {connection} /> : <CmsSetupState pageName="账户中心" error={setupError} cmsSiteUrl={cmsSiteUrl ?? ''} onlinePath="/account/" onlineLabel="进入账户中心" />}
</Layout>
