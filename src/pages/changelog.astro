---
import Layout from '../layouts/Layout.astro';
import { getPublishedUpdates } from '../utils/portalCollections';
import { updateKindLabel, updateStatusLabel } from '../utils/portalLabels';
import { normalizeEntrySlug } from '../utils/slugify';
const updates = (await getPublishedUpdates()).sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
---

<Layout title="更新记录" description="SunTBurst 站点与公开内容的真实变更" postsCount={updates.length} hidePageBanner>
  <section class="mx-auto max-w-4xl border-4 border-[#7c3aed] bg-[#f5f3ff] p-5 shadow-[7px_7px_0_0_#7c3aed] dark:bg-violet-950/40 sm:p-8">
    <h1 class="text-3xl font-black text-violet-900 dark:text-violet-100">更新记录</h1>
    {updates.length === 0 ? <p class="mt-4 font-bold">暂无公开更新。</p> : <ol class="mt-5 grid gap-4">{updates.map((entry) => <li id={normalizeEntrySlug(entry)} class="border-l-4 border-violet-700 bg-white p-4 dark:bg-slate-800"><p class="flex flex-wrap items-center gap-2 text-sm font-black text-violet-700 dark:text-violet-300"><time datetime={entry.data.published.toISOString()}>{entry.data.published.toISOString().slice(0, 10)}</time><span aria-hidden="true">·</span><span data-update-kind={entry.data.kind}>{updateKindLabel(entry.data.kind)}</span><span aria-hidden="true">·</span><span data-update-status={entry.data.status}>{updateStatusLabel(entry.data.status)}</span></p><h2 class="mt-2 text-xl font-black">{entry.data.title}</h2><p class="mt-2 font-bold leading-6">{entry.data.summary}</p></li>)}</ol>}
  </section>
</Layout>
