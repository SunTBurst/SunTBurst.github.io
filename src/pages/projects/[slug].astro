---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CommentsSection from '../../components/comments/CommentsSection.astro';
import { getPublishedProjects } from '../../utils/portalCollections';
import { projectStatusLabel } from '../../utils/portalLabels';
import { normalizeEntrySlug } from '../../utils/slugify';
export async function getStaticPaths() {
  const entries = await getPublishedProjects();
  return entries.map((entry) => ({ params: { slug: normalizeEntrySlug(entry) }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const entrySlug = normalizeEntrySlug(entry);
---

<Layout title={entry.data.title} description={entry.data.summary}>
  <article class="article-paper prose prose-lg mx-auto max-w-3xl border-4 border-[#0284c7] p-5 shadow-[7px_7px_0_0_#0284c7] dark:bg-slate-800 sm:p-8">
    <h1>{entry.data.title}</h1>
    <p><strong>状态：</strong><span data-project-status={entry.data.status}>{projectStatusLabel(entry.data.status)}</span> · <strong>开始：</strong>{entry.data.started.toISOString().slice(0, 10)} · <strong>更新：</strong>{entry.data.updated.toISOString().slice(0, 10)}</p>
    <Content />
    {entry.data.links.length > 0 && <section><h2>可验证链接</h2><ul>{entry.data.links.map((link) => <li><a href={link.href} rel="noopener noreferrer">{link.label}</a></li>)}</ul></section>}
  </article>
  <CommentsSection kind="project" path={`/projects/${encodeURIComponent(entrySlug)}/`} />
</Layout>
