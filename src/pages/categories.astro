---
import Layout from '../layouts/Layout.astro';
import { getProcessedPosts } from '../utils/postsFetcher';
const posts = await getProcessedPosts();
const counts = new Map<string, number>();
for (const post of posts) if (post.category) counts.set(post.category, (counts.get(post.category) ?? 0) + 1);
const categories = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<Layout title="分类" description="按真实文章分类浏览" postsCount={posts.length}>
  <section class="mx-auto max-w-3xl border-4 border-[#0284c7] bg-white p-5 shadow-[7px_7px_0_0_#f59e0b] dark:bg-slate-800 sm:p-8"><h1 class="text-3xl font-black text-[#075985] dark:text-[#bae6fd]">分类</h1>{categories.length === 0 ? <p class="mt-4 font-bold">公开文章发布后，实际分类会在这里出现。</p> : <ul class="mt-5 grid gap-3 sm:grid-cols-2">{categories.map(([name, count]) => <li><a href={`/category/${encodeURIComponent(name)}`} class="flex min-h-[44px] items-center justify-between border-2 border-[#0284c7] bg-[#fde68a] px-4 font-black text-[#075985]"><span class="min-w-0 break-all">{name}</span><span>{count}</span></a></li>)}</ul>}</section>
</Layout>
