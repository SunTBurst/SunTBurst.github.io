---
import Layout from '../layouts/Layout.astro';
import { portalConfig } from '../config/portal';
---

<Layout title="从这里开始" description="选择一条连续的 SunTBurst 公开门户探索路线">
  <article class="mx-auto max-w-4xl border-4 border-[#0284c7] bg-white p-5 shadow-[7px_7px_0_0_#0284c7] dark:bg-slate-800 sm:p-8">
    <h1 class="text-3xl font-black text-[#075985] dark:text-[#bae6fd]">从这里开始</h1>
    <p class="mt-3 font-bold leading-7 text-slate-700 dark:text-slate-200">三条路线都只指向已经构建的公开页面。先看当前入口，再沿下一站继续。</p>
    <ol class="mt-6 grid gap-4 lg:grid-cols-3">
      {portalConfig.startHere.map((item) => (
        <li data-start-path={item.href} class="min-w-0 border-3 border-[#0284c7] bg-[#e0f2fe] p-4 shadow-[4px_4px_0_0_#0284c7] dark:bg-slate-900">
          <h2 class="text-lg font-black text-[#075985] dark:text-[#bae6fd]">{item.title}</h2>
          <p class="mt-2 font-bold leading-6 text-slate-700 dark:text-slate-200">{item.description}</p>
          <a href={item.href} class="mt-4 flex min-h-[44px] min-w-0 items-center break-all border-2 border-[#0284c7] bg-white px-3 font-black text-[#075985] focus-visible:ring-4 focus-visible:ring-[#0ea5e9]/40 dark:bg-slate-800 dark:text-[#bae6fd]">当前入口：{item.href}</a>
          <a href={item.nextHref} class="mt-3 flex min-h-[44px] min-w-0 items-center break-all border-2 border-[#0284c7] bg-[#fde68a] px-3 font-black text-[#075985] focus-visible:ring-4 focus-visible:ring-[#0ea5e9]/40">下一站：{item.nextHref}</a>
        </li>
      ))}
    </ol>
  </article>
</Layout>
