---
import Layout from '../layouts/Layout.astro';
import { portalConfig } from '../config/portal';
---

<Layout title="从这里开始" description="选择一条连续的 SunTBurst 公开门户探索路线">
  <div class="mx-auto grid max-w-5xl gap-6">
    <header class="border-4 border-[#0284c7] bg-[#e0f2fe] p-5 shadow-[7px_7px_0_0_#0284c7] dark:bg-slate-800 sm:p-8">
      <p class="text-xs font-black tracking-[0.18em] text-[#0369a1] dark:text-[#bae6fd]">START HERE</p>
      <h1 class="mt-2 text-3xl font-black text-[#075985] dark:text-[#bae6fd] sm:text-4xl">从一个问题开始，而不是从目录开始</h1>
      <p class="mt-3 max-w-3xl font-bold leading-7 text-slate-700 dark:text-slate-200">选择最接近你此刻兴趣的一条路线。每条路线都有明确终点，也都只指向已经构建的公开页面。</p>
    </header>

    <ol class="grid gap-5 lg:grid-cols-3">
      {portalConfig.journeys.map((journey, journeyIndex) => (
        <li data-visitor-journey={journey.slug} class="min-w-0 border-4 border-[#0284c7] bg-white p-5 shadow-[6px_6px_0_0_#0284c7] dark:bg-slate-800">
          <div class="flex items-center justify-between gap-3">
            <span class="text-3xl font-black text-[#0284c7]">0{journeyIndex + 1}</span>
            <span class="border-2 border-[#0284c7] bg-[#fde68a] px-2 py-1 text-xs font-black text-[#075985]">{journey.duration}</span>
          </div>
          <h2 class="mt-4 text-xl font-black text-[#075985] dark:text-[#bae6fd]">{journey.title}</h2>
          <p class="mt-2 font-bold leading-7 text-slate-700 dark:text-slate-200">{journey.description}</p>
          <ol class="mt-5 grid gap-3 border-l-4 border-[#0284c7] pl-4">
            {journey.stops.map((stop, stopIndex) => (
              <li>
                <a href={stop.href} data-journey-stop={stopIndex + 1} class="flex min-h-[44px] min-w-0 items-center break-words border-2 border-[#0284c7] bg-[#f8fafc] px-3 font-black text-[#075985] underline decoration-2 underline-offset-4 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#0ea5e9]/40 dark:bg-slate-900 dark:text-[#bae6fd]">{stopIndex + 1}. {stop.label} →</a>
              </li>
            ))}
          </ol>
          <p class="mt-5 border-t-2 border-dashed border-[#0284c7] pt-4 text-sm font-bold leading-6 text-slate-600 dark:text-slate-300"><strong class="text-[#075985] dark:text-[#bae6fd]">你会带走：</strong>{journey.outcome}</p>
        </li>
      ))}
    </ol>

    <aside class="border-3 border-[#db2777] bg-[#fdf2f8] p-5 shadow-[4px_4px_0_0_#db2777] dark:bg-pink-950/30">
      <h2 class="text-xl font-black text-pink-900 dark:text-pink-100">还不确定看什么？</h2>
      <p class="mt-2 font-bold leading-7 text-slate-700 dark:text-slate-200">让网站从全部公开内容中选一个真实入口，不需要注册，也不会记录你的选择。</p>
      <a href="/explore" class="mt-4 inline-flex min-h-[44px] items-center border-2 border-pink-700 bg-white px-4 py-2 font-black text-pink-900 shadow-[3px_3px_0_0_#db2777] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-pink-500/40 dark:bg-slate-800 dark:text-pink-100">随机带我逛逛 →</a>
    </aside>
  </div>
</Layout>
