---
import { getProcessedPosts } from '../../../../utils/postsFetcher';

export async function getStaticPaths() {
  const postsPerPage = 10;
  const allPosts = await getProcessedPosts();
  const categoryCounts = new Map<string, number>();

  for (const post of allPosts) {
    if (!post.category) continue;
    categoryCounts.set(post.category, (categoryCounts.get(post.category) || 0) + 1);
  }

  const paths = [];
  for (const [categoryName, postCount] of categoryCounts) {
    const totalPages = Math.ceil(postCount / postsPerPage);
    for (let page = 1; page <= totalPages; page++) {
      paths.push({
        params: { categoryName, page: String(page) }
      });
    }
  }
  return paths;
}

const { categoryName, page } = Astro.params;
return Astro.redirect(`/category/${encodeURIComponent(categoryName || '')}?page=${page}`);
---
