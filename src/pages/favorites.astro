---
import Layout from '../layouts/Layout.astro';
import FavoritesManager from '../components/FavoritesManager.svelte';
import { buildPortalIndex } from '../utils/portalIndex';

const entries = await buildPortalIndex();
---

<Layout title="收藏与足迹" description="当前浏览器本地收藏与阅读足迹边界">
  <FavoritesManager entries={entries} client:load />
</Layout>
