---
import Layout from '../layouts/Layout.astro';
import PostBrowser from '../components/PostBrowser.svelte';
import { getProcessedPosts } from '../utils/postsFetcher';
import { postPath } from '../utils/slugify';
const posts = await getProcessedPosts();
const publicPosts = posts.map((post) => ({
  id: post.id,
  title: post.title,
  description: post.description,
  href: postPath(post.slug),
  date: post.date.slice(0, 10),
  category: post.category,
  tags: post.tags,
}));
---

<Layout title="文章" description="浏览 SunTBurst 已发布文章" postsCount={posts.length}>
  <section class="mx-auto max-w-5xl border-4 border-[#0284c7] bg-white p-5 shadow-[7px_7px_0_0_#0284c7] dark:bg-slate-800 sm:p-8">
    <h1 class="text-3xl font-black text-[#075985] dark:text-[#bae6fd]">文章</h1>
    <p class="mt-3 font-bold leading-7">文章按公开 Markdown 内容生成，可在本页按关键词、分类和标签筛选。</p>
    <nav class="mt-4 flex flex-wrap gap-3"><a class="flex min-h-[44px] items-center border-2 border-[#0284c7] px-4 font-black" href="/categories">分类</a><a class="flex min-h-[44px] items-center border-2 border-[#0284c7] px-4 font-black" href="/tags">标签</a><a class="flex min-h-[44px] items-center border-2 border-[#0284c7] px-4 font-black" href="/search">搜索</a><a class="flex min-h-[44px] items-center border-2 border-[#0284c7] px-4 font-black" href="/archive">时间归档</a></nav>
    <PostBrowser posts={publicPosts} client:load />
  </section>
</Layout>
