---
import MarkdownIt from 'markdown-it';
import sanitizeHtml from 'sanitize-html';
import aboutSource from '../config/about.md?raw';
import Layout from '../layouts/Layout.astro';

const html = sanitizeHtml(new MarkdownIt({ html: false, linkify: false }).render(aboutSource));
---

<Layout title="关于" description="关于 SunTBurst 个人门户">
  <article class="article-paper prose prose-lg mx-auto max-w-3xl border-4 border-[#0284c7] bg-white p-6 shadow-[8px_8px_0_0_#0284c7] dark:bg-slate-800 sm:p-10">
    <Fragment set:html={html} />
  </article>
</Layout>
