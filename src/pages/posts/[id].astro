---
import Layout from '../../layouts/Layout.astro';
import { getProcessedPosts } from '../../utils/postsFetcher';
import { getPublishedPosts } from '../../utils/contentCollections';
import { siteConfig, i18nConfig, contentConfig, githubAuthoringConfig } from '../../config/site';
import { calculateReadingTime } from '../../utils/readingTime';

import { githubContentEditUrl } from '../../utils/githubAuthoring';
import ArticleEnhancements from '../../components/ArticleEnhancements.astro';
import CommentsSection from '../../components/comments/CommentsSection.astro';

export async function getStaticPaths() {
  const posts = await getProcessedPosts();
  return posts.map(post => {
    return {
      params: { id: post.slug },
      props: { post }
    };
  });
}

const { id } = Astro.params;
const { post } = Astro.props;

// Render original collection Markdown using Astro compiler
import { render } from 'astro:content';
const rawPosts = await getPublishedPosts();
const articleEntry = rawPosts.find(p => p.id === post.id);
if (!articleEntry) {
  return Astro.redirect('/404');
}
const { Content, headings } = await render(articleEntry);
const editUrl = githubContentEditUrl(githubAuthoringConfig, articleEntry.filePath);
const readTime = calculateReadingTime(articleEntry.body || "");

// Calculate adjacent posts
const allPosts = await getProcessedPosts();
const idx = allPosts.findIndex(p => p.slug === post.slug);
const prevPost = idx < allPosts.length - 1 ? allPosts[idx + 1] : null;
const nextPost = idx > 0 ? allPosts[idx - 1] : null;

// Map headings to our toc format
const toc = headings.map(h => ({
  level: h.depth,
  text: h.text,
  id: h.slug
}));

const minTocLevel = toc.length > 0 ? Math.min(...toc.map(item => item.level)) : 1;

// Compute related posts by tag overlap
const relatedPosts = (() => {
  if (!post.tags || post.tags.length === 0) return [];
  const scored = allPosts
    .filter(p => p.slug !== post.slug)
    .map(p => ({
      post: p,
      score: (p.tags || []).filter(t => post.tags.includes(t)).length
    }))
    .filter(x => x.score > 0)
    .sort((a, b) => b.score - a.score)
    .slice(0, 3)
    .map(x => x.post);
  return scored;
})();

---


<Layout 
  title={post.title}
  description={post.description}
  image={post.img}
  post={post}
  isArticle={true}
  hidePageBanner
>
  <div class="article-layout mx-auto w-full max-w-[1080px]">
    <div class="flex flex-col lg:flex-row justify-center gap-6 lg:gap-8 items-start w-full">

      {/* Main post body center panel */}
      <div class="min-w-0 w-full max-w-[780px] space-y-6">
        <article data-custom-code-blocks class="article-paper border border-[#0284c7]/20 p-5 sm:p-8 md:p-10 rounded-lg">
          <div class="border-b border-[#0284c7]/20 pb-6 mb-8">
            <div>
              <h1 class="text-2xl sm:text-3xl font-bold text-[#075985] dark:text-[#bae6fd] mb-4 leading-snug">{post.title}</h1>
              <div class="flex flex-wrap items-center gap-3">
                <span class="text-slate-500 dark:text-slate-400 text-sm">{post.date}</span>
                <span class="text-slate-500 dark:text-slate-400 text-sm">/ {i18nConfig.post.readingTime} {readTime} {i18nConfig.post.readingTimeUnit}</span>
                
                {post.category && (
                  <a 
                    href={`/category/${post.category}`} 
                    data-post-taxonomy
                    class="inline-flex min-h-[44px] items-center bg-[#fde68a] border-2 border-[#0284c7] px-2.5 py-0.5 shadow-[2px_2px_0px_0px_#0284c7] text-center font-bold text-[#075985] text-xs hover:bg-[#0369a1] hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#0ea5e9]/40"
                  >
                    {post.category}
                  </a>
                )}

                {post.tags && post.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2">
                    {post.tags.map(tag => (
                      <a 
                        href={`/tag/${tag}`} 
                        data-post-taxonomy
                        class="inline-flex min-h-[44px] items-center text-xs font-bold bg-white border-2 border-[#0284c7] text-slate-700 px-2.5 py-0.5 shadow-[2px_2px_0px_0px_#0284c7] hover:bg-[#0369a1] hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#0ea5e9]/40"
                      >
                        #{tag}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </div>

          </div>

            {toc.length > 0 && (
              <details class="mb-7 rounded-md border border-[#0284c7]/20 px-4 lg:hidden" data-mobile-toc>
                <summary class="flex min-h-[44px] cursor-pointer items-center py-2 font-semibold text-[#075985] dark:text-[#bae6fd]">本文目录 <span aria-hidden="true" class="ml-auto">⌄</span></summary>
                <nav aria-label="本文目录" class="grid pb-3">
                  {toc.map((item) => <a href={`#${item.id}`} style={{ paddingLeft: `${(item.level - minTocLevel) * 12}px` }} class="min-h-[44px] py-3 text-sm leading-5 text-slate-600 underline underline-offset-4 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#0ea5e9]/40 dark:text-slate-300">{item.text}</a>)}
                </nav>
              </details>
            )}

            {/* Prose Content block */}
            <div class="prose prose-slate dark:prose-invert prose-lg max-w-none w-full min-w-0 break-words">
              <Content />
            </div>
          </article>
        <ArticleEnhancements title={post.title} description={post.description} canonicalUrl={Astro.url.href} />
        <CommentsSection kind="post" path={`/posts/${encodeURIComponent(post.slug)}/`} />

        {editUrl && <a href={editUrl} target="_blank" rel="noopener noreferrer" data-post-edit class="inline-flex min-h-[44px] items-center px-1 text-sm text-[#075985] underline underline-offset-4 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#0ea5e9]/40 dark:text-[#bae6fd]">在 GitHub 编辑本文 <span aria-hidden="true" class="ml-1">↗</span></a>}

        {/* Copyright Metadata block */}
        <div 
          class="site-surface dark:bg-slate-800 border border-[#0284c7]/20 p-5 md:p-7 shadow-sm rounded-sm relative transition-all duration-300 group/copyright animate-card-entrance opacity-0"
          id="post-copyright-card"
          style="animation-delay: 0.1s"
        >
          <div class="relative z-10 space-y-4">
            <div class="flex items-start justify-between gap-3">
              <h3 class="text-base sm:text-lg font-black text-[#075985] leading-snug min-w-0 dark:text-[#bae6fd]">文章信息</h3>
            </div>
            
            <div class="inline-block bg-[#e0f2fe]/80 border-2 border-[#0ea5e9]/20 px-3 rounded-sm text-xs font-bold hover:bg-[#e0f2fe] transition-all break-all select-all">
              <a href={Astro.url.href} target="_blank" rel="noopener noreferrer" data-post-canonical class="inline-flex min-h-[44px] items-center text-[#075985] underline decoration-2 underline-offset-4 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#0ea5e9]/40">
                {Astro.url.href}
              </a>
            </div>

            <div class="grid grid-cols-3 gap-3 border-t-2 border-dashed border-[#0284c7]/20 pt-4 text-[11px] sm:text-xs">
              <div>
                <div class="text-slate-400 font-bold mb-1 uppercase tracking-wider">{i18nConfig.post.copyrightTitle}</div>
                <div class="font-extrabold text-[#0284c7] hover:translate-x-0.5 transition-transform">{siteConfig.author}</div>
              </div>
              <div>
                <div class="text-slate-400 font-bold mb-1 uppercase tracking-wider">{i18nConfig.post.publishedTitle}</div>
                <div class="font-mono font-bold text-slate-600">{post.date}</div>
              </div>
              <div>
                <div class="text-slate-400 font-bold mb-1 uppercase tracking-wider">{i18nConfig.post.licenseTitle}</div>
                <div>
                  <a href={contentConfig.license.url} data-post-license class="inline-flex min-h-[44px] items-center font-bold text-[#075985] underline decoration-2 underline-offset-4 transition-all focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#0ea5e9]/40 dark:text-[#bae6fd]">
                    {contentConfig.license.name}
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* Related Posts */}
        {relatedPosts.length > 0 && (
          <div class="animate-card-entrance opacity-0" style="animation-delay: 0.08s">
            <div class="site-surface dark:bg-slate-800 border border-[#0284c7]/20 p-4 shadow-sm rounded-sm">
              <h3 class="font-black text-[#0284c7] text-sm mb-3 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M12 2a10 10 0 100 20 10 10 0 000-20z" />
                </svg>
                {i18nConfig.post.relatedPosts}
              </h3>
              <div class="flex flex-wrap gap-2">
                {relatedPosts.map(rp => (
                  <a
                    href={`/posts/${encodeURIComponent(rp.slug)}`}
                    class="group site-surface dark:bg-slate-700 border-2 border-[#0284c7] px-3 py-2 rounded-sm shadow-[3px_3px_0px_0px_#0284c7] hover:shadow-none hover:translate-x-0.5 hover:translate-y-0.5 transition-all duration-200 inline-flex items-center gap-2"
                  >
                    <span class="text-xs font-black text-slate-700 dark:text-slate-200 group-hover:text-[#0ea5e9] transition-colors whitespace-nowrap">{rp.title}</span>
                    <span class="text-[9px] font-bold text-slate-400 font-mono shrink-0">{rp.date}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        )}

        {/* Previous / Next pagination navigation blocks */}
        <div class="flex flex-col sm:flex-row gap-3 w-full animate-card-entrance opacity-0" style="animation-delay: 0.1s">
          {prevPost ? (
            <a 
              href={`/posts/${encodeURIComponent(prevPost.slug)}`}
              class="flex-1 min-w-0 site-surface dark:bg-slate-800 hover:bg-[#e0f2fe] dark:hover:bg-slate-700 border border-[#0284c7]/20 px-4 py-3 rounded-sm shadow-sm hover:shadow-none hover:translate-x-0.5 hover:translate-y-0.5 transition-all duration-200 flex items-center gap-3 group text-left"
            >
              <span class="text-[#0ea5e9] group-hover:-translate-x-1 transition-transform shrink-0 font-extrabold">❮</span>
              <div class="min-w-0 flex-1">
                <div class="text-[9px] uppercase font-black tracking-widest text-slate-400 mb-0.5">{i18nConfig.post.prevPost}</div>
                <p class="text-xs sm:text-sm font-black text-slate-700 dark:text-slate-200 truncate">{prevPost.title}</p>
              </div>
            </a>
          ) : (
            <div class="hidden sm:block flex-1 border-3 border-dashed border-[#0284c7]/20 px-4 py-3 rounded-sm text-center text-xs font-black text-slate-400 dark:text-slate-500 bg-slate-50/30 dark:bg-slate-700/30">
              {i18nConfig.post.noMorePrev}
            </div>
          )}

          {nextPost ? (
            <a 
              href={`/posts/${encodeURIComponent(nextPost.slug)}`}
              class="flex-1 min-w-0 site-surface dark:bg-slate-800 hover:bg-[#e0f2fe] dark:hover:bg-slate-700 border border-[#0284c7]/20 px-4 py-3 rounded-sm shadow-sm hover:shadow-none hover:translate-x-0.5 hover:translate-y-0.5 transition-all duration-200 flex items-center justify-between gap-3 group text-right"
            >
              <div class="min-w-0 flex-1">
                <div class="text-[9px] uppercase font-black tracking-widest text-slate-400 mb-0.5">{i18nConfig.post.nextPost}</div>
                <p class="text-xs sm:text-sm font-black text-slate-700 dark:text-slate-200 truncate">{nextPost.title}</p>
              </div>
              <span class="text-[#0ea5e9] group-hover:translate-x-1 transition-transform shrink-0 font-extrabold">❯</span>
            </a>
          ) : (
            <div class="hidden sm:block flex-1 border-3 border-dashed border-[#0284c7]/20 px-4 py-3 rounded-sm text-center text-xs font-black text-slate-400 dark:text-slate-500 bg-slate-50/30 dark:bg-slate-700/30">
              {i18nConfig.post.noMoreNext}
            </div>
          )}
        </div>

      </div>

      {toc.length > 0 && (
        <aside data-desktop-toc class="hidden lg:block w-[240px] shrink-0 sticky top-[88px] self-start border-l border-[#0284c7]/20 pl-5">
          <h2 class="mb-3 text-sm font-semibold text-[#075985] dark:text-[#bae6fd]">本文目录</h2>
          <nav id="toc-container" aria-label="本文目录" class="max-h-[calc(100vh-130px)] overflow-y-auto pr-2 custom-scrollbar">
            <ul class="space-y-1 text-sm">
              {toc.map((item) => (
                <li style={{ paddingLeft: `${(item.level - minTocLevel) * 12}px` }}>
                  <a href={`#${item.id}`} data-id={item.id} class="toc-nav-link block border-l-2 border-transparent py-2 pl-2 leading-6 text-slate-600 hover:text-[#0369a1] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#0ea5e9]/40 dark:text-slate-300">{item.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}

    </div>

  </div>
</Layout>

<script>
  function setupPostDetail() {
    // Render image captions for images with alt text
    function setupImageCaptions() {
      const content = document.querySelector('.prose');
      if (!content) return;
      content.querySelectorAll('img[alt]').forEach(img => {
        if (!img.alt || img.closest('figure')) return;
        const p = img.closest('p');
        if (!p || p.children.length !== 1) return;
        const fig = document.createElement('figure');
        const cap = document.createElement('figcaption');
        cap.textContent = img.alt;
        p.parentNode.replaceChild(fig, p);
        fig.appendChild(img);
        fig.appendChild(cap);
      });
    }

    // Enhance Code Blocks with Mac Style
    function enhanceCodeBlocks() {
      // Find all pre elements - Shiki puts language info on the pre tag usually
      const codeBlocks = document.querySelectorAll('.prose pre');
      codeBlocks.forEach(pre => {
        if (pre.hasAttribute('data-enhanced')) return;
        pre.setAttribute('data-enhanced', 'true');
        
        // Language detection - check data attributes first then classes
        let language = pre.getAttribute('data-language') || 'code';
        if (language === 'code') {
          const match = pre.className.match(/language-(\w+)/);
          if (match) language = match[1];
        }
        
        // Create container
        const container = document.createElement('div');
        container.setAttribute('data-code-block', '');
        container.className = 'my-8 relative border border-[#0284c7]/20 rounded-sm overflow-hidden bg-[#1e293b] shadow-sm group animate-card-entrance';
        
        // Header
        const header = document.createElement('div');
        header.className = 'bg-[#f1f5f9] border-b-4 border-[#0284c7] px-4 py-2 flex items-center justify-between select-none';
        header.innerHTML = `
          <div class="flex gap-2 items-center">
            <div class="w-2 h-2 rounded-full bg-[#ff5f56]"></div>
            <div class="w-2 h-2 rounded-full bg-[#ffbd2e]"></div>
            <div class="w-2 h-2 rounded-full bg-[#27c93f]"></div>
          </div>
          <div class="font-mono text-[9px] font-black text-[#0284c7] uppercase tracking-[0.2em] opacity-80">${language}</div>
          <button type="button" aria-label="复制代码" class="copy-btn min-h-[44px] min-w-[44px] inline-flex items-center justify-center text-[#0284c7] hover:bg-[#0ea5e9] hover:text-white transition-all p-1 border-2 border-[#0284c7] rounded-sm bg-white shadow-[2px_2px_0px_0px_#0284c7] hover:shadow-none translate-x-[-1px] translate-y-[-1px] hover:translate-x-0 hover:translate-y-0" title="复制代码">
            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          </button>
        `;
        
        const copyBtn = header.querySelector('.copy-btn');
        copyBtn.addEventListener('click', () => {
          const codeText = pre.innerText;
          navigator.clipboard.writeText(codeText).then(() => {
            copyBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>';
            setTimeout(() => {
              copyBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>';
            }, 2000);
          });
        });

        // Content Wrapper
        const content = document.createElement('div');
        content.className = 'relative flex flex-col min-h-0';
        
        const scrollArea = document.createElement('div');
        scrollArea.className = 'overflow-x-auto custom-scrollbar text-sm font-mono leading-relaxed';
        
        // Reparent
        pre.parentNode.insertBefore(container, pre);
        container.appendChild(header);
        container.appendChild(content);
        content.appendChild(scrollArea);
        scrollArea.appendChild(pre);
        
        // Folding logic
        const lines = pre.innerText.split('\n').filter(l => l.trim()).length;
        if (lines > 40) {
          scrollArea.classList.add('max-h-[600px]', 'transition-all', 'duration-500');
          
          const overlay = document.createElement('div');
          overlay.className = 'absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-[#1e293b] via-[#1e293b]/90 to-transparent flex items-end justify-center pb-4 z-10 fold-overlay';
          overlay.innerHTML = `
            <button type="button" class="expand-btn min-h-[44px] bg-[#0ea5e9] border-2 border-[#0284c7] text-white font-black px-4 py-1.5 flex items-center gap-2 shadow-[3px_3px_0px_0px_#0284c7] hover:shadow-none hover:translate-x-0.5 hover:translate-y-0.5 transition-all text-xs rounded-sm uppercase tracking-wider">
              展开代码 <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </button>
          `;
          
          content.appendChild(overlay);
          
          const expandBtn = overlay.querySelector('.expand-btn');
          expandBtn.addEventListener('click', () => {
            scrollArea.style.maxHeight = 'none';
            overlay.classList.add('hidden');
            
            // Add collapse button at bottom
            const footer = document.createElement('div');
            footer.className = 'border-t-2 border-dashed border-[#0284c7]/20 bg-[#1e293b]/50 p-2 flex justify-center collapse-footer';
            footer.innerHTML = `
              <button type="button" class="collapse-btn min-h-[44px] bg-white border-2 border-[#0284c7] text-[#0284c7] font-black px-4 py-1 flex items-center gap-2 shadow-[2px_2px_0px_0px_#0284c7] hover:shadow-none hover:translate-x-0.5 hover:translate-y-0.5 transition-all text-[10px] rounded-sm uppercase tracking-wider">
                收起代码 <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
              </button>
            `;
            content.appendChild(footer);
            footer.querySelector('.collapse-btn').addEventListener('click', () => {
              scrollArea.style.maxHeight = '600px';
              overlay.classList.remove('hidden');
              footer.remove();
              // Smooth scroll back to top of container if hidden
              const rect = container.getBoundingClientRect();
              if (rect.top < 0) {
                window.scrollTo({
                  top: window.scrollY + rect.top - 100,
                  behavior: 'smooth'
                });
              }
            });
          });
        }

        // Apply clean styles to the original pre
        pre.style.margin = '0';
        pre.style.padding = '1.25rem';
        pre.style.borderRadius = '0';
        pre.style.backgroundColor = 'transparent';
      });
    }

    setupImageCaptions();
    enhanceCodeBlocks();
  }

  // Initial run
  requestAnimationFrame(setupPostDetail);

  // Re-run on page transitions (guard against duplicates)
  if (!window._postDetailListenersInited) {
    document.addEventListener('astro:page-load', () => requestAnimationFrame(setupPostDetail));
    window._postDetailListenersInited = true;
  }
</script>

<style is:global>
  .toc-nav-link.active-toc-link {
    border-left-width: 4px;
    border-color: #0ea5e9;
    background-color: rgb(224 242 254 / 0.6);
    border-top-right-radius: 0.375rem;
    border-bottom-right-radius: 0.375rem;
    color: #0ea5e9;
    font-weight: 800;
    transform: scale(1.02);
  }
  .prose h1:target, .prose h2:target, .prose h3:target, .prose h4:target {
    background-color: rgb(254 249 195 / 0.5);
  }
</style>
