---
import Layout from '../../layouts/Layout.astro';
import { getProcessedTalks } from '../../utils/postsFetcher';
import SvelteTalkDetail from '../../components/SvelteTalkDetail.svelte';
import ArticleEnhancements from '../../components/ArticleEnhancements.astro';
import CommentsSection from '../../components/comments/CommentsSection.astro';
import { i18nConfig } from '../../config/site';

export async function getStaticPaths() {
  const talks = await getProcessedTalks();
  return talks.map(talk => {
    return {
      params: { id: talk.slug },
      props: { talk }
    };
  });
}

const { id } = Astro.params;
const suppliedTalk = Astro.props.talk;
const talks = await getProcessedTalks();
const talk = suppliedTalk ?? talks.find((candidate) => candidate.slug === id);
if (!talk) return new Response('Not found', { status: 404 });

/** SEO description: plain text, first 150 chars only */
function talkSeoDescription(raw: string, max = 150): string {
  const plain = (raw || '')
    .replace(/!\[.*?\]\(.*?\)/g, '')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[#*`_~>|]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  if (plain.length <= max) return plain;
  return plain.slice(0, max);
}

const seoDescription = talkSeoDescription(talk.plainText || '');
---

<Layout 
  title={talk.title || i18nConfig.talk.detailFallbackTitle}
  description={seoDescription}
  keywords={[talk.title || '说说', ...(talk.tags || []), '博客说说']}
>
  <SvelteTalkDetail talk={talk} client:load />
  <ArticleEnhancements title={talk.title || i18nConfig.talk.detailFallbackTitle} description={seoDescription} canonicalUrl={Astro.url.href} />
  <CommentsSection kind="talk" path={`/talk/${encodeURIComponent(talk.slug)}/`} />
</Layout>
