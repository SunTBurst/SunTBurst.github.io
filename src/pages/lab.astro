---
import Layout from '../layouts/Layout.astro';
import { portalTools } from '../utils/homeModel';

const readyTools = portalTools.filter(({ state }) => state === 'ready');
const previewTools = portalTools.filter(({ state }) => state === 'preview');
---

<Layout title="实验室" description="仅列出当前已实现并明确边界的本地实验" hidePageBanner>
  <div class="mx-auto grid max-w-5xl gap-6">
    <section class="border-4 border-[#0284c7] bg-white p-5 shadow-[7px_7px_0_0_#f59e0b] dark:bg-slate-800 sm:p-8">
      <p class="text-xs font-black tracking-[0.16em] text-[#0369a1]">LOCAL TOOLS</p>
      <h1 class="mt-1 text-3xl font-black text-[#075985] dark:text-[#bae6fd]">实验室</h1>
      <p class="mt-3 max-w-3xl font-bold leading-7 text-slate-700 dark:text-slate-200">这里集中展示已经能用的门户工具。它们读取构建时发布的公开内容，或只在当前浏览器保存状态。</p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {readyTools.map((tool) => (
          <li class="min-w-0 border-3 border-emerald-700 bg-emerald-50 shadow-[4px_4px_0_0_#047857] dark:bg-emerald-950/30">
            <a href={tool.href} data-lab-tool="ready" class="group flex min-h-[164px] flex-col p-4 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-emerald-500/40">
              <span class="text-xs font-black text-emerald-700 dark:text-emerald-300">现在可用</span>
              <strong class="mt-2 text-xl font-black text-emerald-900 underline decoration-2 underline-offset-4 dark:text-emerald-100">{tool.title}</strong>
              <span class="mt-2 grow text-sm font-bold leading-6 text-slate-700 dark:text-slate-200">{tool.description}</span>
              <span class="mt-3 text-sm font-black text-emerald-800 dark:text-emerald-200">打开工具 →</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="border-4 border-slate-500 bg-slate-100 p-5 shadow-[7px_7px_0_0_#475569] dark:bg-slate-800 sm:p-8">
      <p class="text-xs font-black tracking-[0.16em] text-slate-600 dark:text-slate-300">INTEGRATION NOTES</p>
      <h2 class="mt-1 text-2xl font-black text-slate-800 dark:text-slate-100">后续接入能力</h2>
      <p class="mt-3 font-bold leading-7 text-slate-700 dark:text-slate-200">这些页面用于说明用途、隐私和启用条件。接入真实服务前，不显示假数据，也不发送外部请求。</p>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {previewTools.map((tool) => (
          <li class="min-w-0 border-2 border-slate-500 bg-white dark:bg-slate-900">
            <a href={tool.href} data-lab-tool="preview" class="flex min-h-[144px] flex-col p-4 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-slate-500/40">
              <span class="text-xs font-black text-slate-500 dark:text-slate-400">接入说明</span>
              <strong class="mt-2 font-black text-slate-900 underline decoration-2 underline-offset-4 dark:text-slate-100">{tool.title}</strong>
              <span class="mt-2 text-sm font-bold leading-6 text-slate-600 dark:text-slate-300">{tool.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Layout>
