---
import UnifiedSearch from '../components/UnifiedSearch.svelte';
import Layout from '../layouts/Layout.astro';
import { buildPortalIndex, buildPortalSearchText } from '../utils/portalIndex';
const [entries, searchTextById] = await Promise.all([buildPortalIndex(), buildPortalSearchText()]);
---

<Layout title="搜索" description="在构建期公开索引中搜索"><UnifiedSearch entries={entries} searchTextById={searchTextById} client:load /></Layout>
