---
import {
  FRIEND_LINK_ISSUE_URL,
  curatedBookmarks,
  friendLinks,
  type CuratedBookmark,
} from '../config/friends';
import Layout from '../layouts/Layout.astro';

const bookmarkCategories: CuratedBookmark['category'][] = ['建站基础', '内容与开放标准', '知识管理'];
---

<Layout title="友链与书签" description="真实友链、申请入口和 SunTBurst 实际参考的站外资料" hidePageBanner>
  <div class="mx-auto grid max-w-5xl gap-6">
    <header class="border-4 border-[#0284c7] bg-[#e0f2fe] p-5 shadow-[7px_7px_0_0_#f59e0b] dark:bg-slate-800 sm:p-8">
      <p class="text-xs font-black tracking-[0.18em] text-[#0369a1] dark:text-[#bae6fd]">FRIENDS · BOOKMARKS</p>
      <h1 class="mt-1 text-3xl font-black text-[#075985] dark:text-[#bae6fd]">友链与书签</h1>
      <p class="mt-3 max-w-3xl font-bold leading-7 text-slate-700 dark:text-slate-200">友链只记录真实建立联系的个人网站，不虚构互换关系。书签则公开这个门户实际使用或参考的资料，两者不会混在一起冒充朋友。</p>
    </header>

    <section aria-labelledby="friend-links-title" data-friend-state={friendLinks.length === 0 ? 'empty' : 'listed'} class="border-4 border-pink-700 bg-pink-50 p-5 shadow-[6px_6px_0_0_#be185d] dark:bg-pink-950/30 sm:p-8">
      <p class="text-xs font-black tracking-[0.16em] text-pink-800 dark:text-pink-200">RECIPROCAL LINKS</p>
      <h2 id="friend-links-title" class="mt-1 text-2xl font-black text-pink-900 dark:text-pink-100">真实友链</h2>
      {friendLinks.length === 0 ? (
        <div class="mt-4 border-3 border-dashed border-pink-700 bg-white p-5 dark:bg-slate-900">
          <p class="font-black text-slate-800 dark:text-white">第一个友链席位仍在等待真实的网站。</p>
          <p class="mt-2 font-bold leading-7 text-slate-600 dark:text-slate-300">空白会如实保留，不用模板站点或自有账号凑数。你仍可以继续浏览下方已经核对的站外书签。</p>
        </div>
      ) : (
        <ul class="mt-5 grid gap-4 sm:grid-cols-2">
          {friendLinks.map((friend) => (
            <li class="border-3 border-pink-700 bg-white p-4 dark:bg-slate-900">
              <a href={friend.href} target="_blank" rel="noopener noreferrer" class="flex min-h-[44px] items-center font-black text-pink-900 underline decoration-2 underline-offset-4 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-pink-500/40 dark:text-pink-100">{friend.title} ↗</a>
              <p class="mt-2 text-sm font-bold leading-6 text-slate-600 dark:text-slate-300">{friend.description}</p>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section aria-labelledby="bookmarks-title" class="border-4 border-emerald-700 bg-emerald-50 p-5 shadow-[6px_6px_0_0_#047857] dark:bg-emerald-950/30 sm:p-8">
      <p class="text-xs font-black tracking-[0.16em] text-emerald-800 dark:text-emerald-200">CURATED REFERENCES</p>
      <h2 id="bookmarks-title" class="mt-1 text-2xl font-black text-emerald-900 dark:text-emerald-100">这个门户实际参考什么</h2>
      <p class="mt-3 font-bold leading-7 text-slate-700 dark:text-slate-200">这些是官方文档、开放规范或长期维护的学习资料，不代表互换友链，也不含付费推广。</p>
      <div class="mt-5 grid gap-5">
        {bookmarkCategories.map((category) => (
          <section data-bookmark-category={category} aria-labelledby={`bookmark-${category}`}>
            <h3 id={`bookmark-${category}`} class="text-lg font-black text-emerald-900 dark:text-emerald-100">{category}</h3>
            <ul class="mt-3 grid gap-3 md:grid-cols-2">
              {curatedBookmarks.filter((bookmark) => bookmark.category === category).map((bookmark) => (
                <li class="min-w-0 border-3 border-emerald-700 bg-white p-4 dark:bg-slate-900">
                  <a href={bookmark.href} data-curated-bookmark={bookmark.title} target="_blank" rel="noopener noreferrer" class="flex min-h-[44px] min-w-0 items-center break-words font-black text-emerald-900 underline decoration-2 underline-offset-4 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-emerald-500/40 dark:text-emerald-100">{bookmark.title} ↗</a>
                  <p class="mt-2 text-sm font-bold leading-6 text-slate-600 dark:text-slate-300">{bookmark.description}</p>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </section>

    <section aria-labelledby="friend-application-title" class="border-4 border-amber-700 bg-amber-50 p-5 shadow-[6px_6px_0_0_#b45309] dark:bg-amber-950/30 sm:p-8">
      <p class="text-xs font-black tracking-[0.16em] text-amber-800 dark:text-amber-200">OPEN APPLICATION</p>
      <h2 id="friend-application-title" class="mt-1 text-2xl font-black text-amber-900 dark:text-amber-100">申请交换友链</h2>
      <p class="mt-3 font-bold leading-7 text-slate-700 dark:text-slate-200">申请入口使用本仓库的 GitHub Issue，只需 GitHub 账号。网站应能通过 HTTPS 稳定访问，有明确主题和真实内容；是否互相添加由双方分别决定。</p>
      <p class="mt-2 text-sm font-bold leading-6 text-slate-600 dark:text-slate-300">GitHub Issue 是公开页面，请勿填写邮箱、手机号或其他非公开个人信息。提交后适用 GitHub 的隐私政策。</p>
      <a href={FRIEND_LINK_ISSUE_URL} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex min-h-[48px] items-center border-3 border-amber-800 bg-[#fde68a] px-5 py-2 font-black text-amber-900 shadow-[4px_4px_0_0_#92400e] transition hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-amber-500/40 dark:text-amber-950">打开 GitHub 友链申请 ↗</a>
    </section>
  </div>
</Layout>
