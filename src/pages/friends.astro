---
import friends from '../config/friends.json';
import Layout from '../layouts/Layout.astro';
---

<Layout title="友链" description="TSun 的博客友链">
  <section class="mx-auto max-w-3xl border-4 border-[#0284c7] bg-white p-6 shadow-[8px_8px_0_0_#f59e0b] dark:bg-slate-800 sm:p-10">
    <h1 class="mb-6 text-3xl font-black text-[#0284c7]">友链</h1>
    {friends.length === 0 ? (
      <p class="border-2 border-dashed border-[#0284c7] bg-[#fde68a]/40 p-5 font-bold text-slate-600 dark:text-slate-200">这里暂时还是空的。</p>
    ) : (
      <ul class="grid gap-4 sm:grid-cols-2">
        {friends.map((friend) => <li>{friend}</li>)}
      </ul>
    )}
  </section>
</Layout>
