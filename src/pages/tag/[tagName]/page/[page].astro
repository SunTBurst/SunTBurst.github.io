---
import { getProcessedPosts } from '../../../../utils/postsFetcher';

export async function getStaticPaths() {
  const postsPerPage = 10;
  const allPosts = await getProcessedPosts();
  const tagCounts = new Map<string, number>();

  for (const post of allPosts) {
    if (post.tags) {
      for (const tag of new Set(post.tags)) {
        tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
      }
    }
  }

  const paths = [];
  for (const [tagName, postCount] of tagCounts) {
    const totalPages = Math.ceil(postCount / postsPerPage);
    for (let page = 1; page <= totalPages; page++) {
      paths.push({
        params: { tagName, page: String(page) }
      });
    }
  }
  return paths;
}

const { tagName, page } = Astro.params;
return Astro.redirect(`/tag/${encodeURIComponent(tagName || '')}?page=${page}`);
---
