---
import PortalHome from '../components/home/PortalHome.astro';
import Layout from '../layouts/Layout.astro';
import type { PortalProject } from '../types/portal';
import { buildHomeModel } from '../utils/homeModel';
import { getPublishedProjects } from '../utils/portalCollections';
import { buildPortalIndex } from '../utils/portalIndex';
import { normalizeEntrySlug } from '../utils/slugify';

const portalIndex = await buildPortalIndex();
const publishedProjects = await getPublishedProjects();
const projects: PortalProject[] = publishedProjects.map((entry) => ({
  slug: normalizeEntrySlug(entry),
  title: entry.data.title,
  summary: entry.data.summary,
  status: entry.data.status,
  href: `/projects/${encodeURIComponent(normalizeEntrySlug(entry))}/`,
  updated: entry.data.updated.toISOString().slice(0, 10),
}));
const byKind = (kind: 'post' | 'talk' | 'knowledge' | 'update') => portalIndex.filter((entry) => entry.kind === kind);
const model = buildHomeModel({
  posts: byKind('post'),
  talks: byKind('talk'),
  knowledge: byKind('knowledge'),
  projects,
  updates: byKind('update'),
});
---

<Layout title="SunTBurst 个人门户" description="把学习、实践与知识连接成一张长期生长的地图" isPortalHome hidePageBanner>
  <PortalHome model={model} />
</Layout>
