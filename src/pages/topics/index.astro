---
import Layout from '../../layouts/Layout.astro';
import { portalConfig } from '../../config/portal';
---

<Layout title="主题" description="跨内容类型浏览 SunTBurst 公开主题">
  <section class="mx-auto max-w-4xl border-4 border-[#059669] bg-[#ecfdf5] p-5 shadow-[7px_7px_0_0_#059669] dark:bg-emerald-950/40 sm:p-8"><h1 class="text-3xl font-black text-emerald-900 dark:text-emerald-100">主题地图</h1><ul class="mt-5 grid gap-4 sm:grid-cols-3">{portalConfig.topics.map((topic) => <li class="min-w-0 border-2 border-emerald-700 bg-white p-4 dark:bg-slate-800"><a class="flex min-h-[44px] min-w-0 items-center break-all font-black text-emerald-900 underline dark:text-emerald-100" href={`/topics/${encodeURIComponent(topic.slug)}`}>{topic.title}</a><p class="mt-2 font-bold leading-6">{topic.description}</p><p class="mt-2 text-xs font-black">{topic.status}</p></li>)}</ul></section>
</Layout>
