---
import type { HomePulseItem } from '../../utils/homeModel';

interface Props {
  items: HomePulseItem[];
}

const { items } = Astro.props;
---

<section id="portal-pulse" aria-labelledby="portal-pulse-title" class="mt-8">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <p class="text-xs font-black tracking-[0.16em] text-[#0369a1]">PORTAL PULSE</p>
      <h2 id="portal-pulse-title" class="mt-1 text-2xl font-black text-[#075985] dark:text-[#bae6fd]">站点脉搏</h2>
    </div>
    <p class="text-sm font-bold text-slate-600 dark:text-slate-300">只统计仓库中真实发布的内容，不显示虚构流量。</p>
  </div>
  <ul class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4">
    {items.map((item) => (
      <li class="min-w-0 border-3 border-[#0284c7] bg-white shadow-[4px_4px_0_0_#0284c7] dark:bg-slate-800">
        <a href={item.href} class="group flex min-h-[132px] flex-col justify-between p-4 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#0ea5e9]/40 focus-visible:ring-offset-2">
          <span class="text-sm font-black text-slate-600 dark:text-slate-300">{item.label}</span>
          <strong class="my-2 text-4xl font-black text-[#075985] transition group-hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:group-hover:translate-y-0 dark:text-[#bae6fd]">{item.value}</strong>
          <span class="text-xs font-bold leading-5 text-slate-600 dark:text-slate-300">{item.detail} →</span>
        </a>
      </li>
    ))}
  </ul>
</section>
