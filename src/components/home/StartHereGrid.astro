---
import type { PortalLink } from '../../types/portal';

interface Props {
  paths: PortalLink[];
}

const { paths } = Astro.props;
---

<section id="start-here" aria-labelledby="start-here-title" class="mt-8">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <p class="text-xs font-black tracking-[0.16em] text-[#0369a1]">START HERE</p>
      <h2 id="start-here-title" class="mt-1 text-2xl font-black text-[#075985] dark:text-[#bae6fd]">从这里开始</h2>
    </div>
    <p class="text-sm font-bold text-slate-600 dark:text-slate-300">选择一条路线，再决定下一步。</p>
  </div>
  <ul class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-3">
    {paths.map((path) => (
      <li data-start-path={path.href} class="min-w-0 border-3 border-[#0284c7] bg-white p-4 shadow-[4px_4px_0_0_#0284c7] dark:bg-slate-800">
        <h3 class="text-lg font-black text-[#075985] dark:text-[#bae6fd]"><a href={path.href} data-touch-target="start-current" class="inline-flex min-h-[44px] min-w-0 max-w-full items-center break-all px-3 py-2 underline decoration-2 underline-offset-4 transition hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#0ea5e9]/40 focus-visible:ring-offset-2 motion-reduce:transition-none motion-reduce:hover:translate-y-0">{path.title}</a></h3>
        <p class="mt-2 text-sm font-bold leading-6 text-slate-700 dark:text-slate-200">{path.description}</p>
        <p class="mt-4 text-sm font-black text-[#0369a1]">接下来可去：<a href={path.nextHref} data-touch-target="start-next" class="inline-flex min-h-[44px] min-w-0 max-w-full items-center break-all px-3 py-2 align-middle underline underline-offset-2 transition hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#0ea5e9]/40 focus-visible:ring-offset-2 motion-reduce:transition-none motion-reduce:hover:translate-y-0">{path.nextHref}</a></p>
      </li>
    ))}
  </ul>
</section>
