---
import type { HomeModel } from '../../utils/homeModel';
import { appearanceConfig } from '../../config/site';

interface Props {
  identity: HomeModel['identity'];
  lastUpdated: string;
}
const { identity, lastUpdated } = Astro.props;
---

<section id="identity" data-layout-hero aria-labelledby="identity-title" class="border-b border-[#0284c7]/20 pb-8 pt-3 sm:pb-10 sm:pt-5">
  <p class="text-xs font-semibold tracking-[0.18em] text-[#0369a1] dark:text-[#bae6fd]">记录 · 学习 · 实践</p>
  <h1 id="identity-title" class="mt-3 break-words text-4xl font-bold tracking-tight text-[#075985] sm:text-5xl dark:text-[#bae6fd]">{identity.name}</h1>
  <p data-layout-hero-tagline class="mt-4 max-w-2xl text-base leading-7 text-slate-600 dark:text-slate-300">{identity.tagline}</p>
  <div data-layout-hero-actions class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
    <a href="/posts" class="inline-flex min-h-[44px] items-center rounded-md border border-[#0284c7] bg-[#fde68a] px-5 py-2 text-sm font-semibold text-[#075985] shadow-[2px_2px_0_0_#0284c7] transition hover:bg-[#fcd34d] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#0ea5e9]/40 motion-reduce:transition-none">浏览文章 <span aria-hidden="true" class="ml-2">→</span></a>
    {lastUpdated && <p class="text-xs text-slate-500 dark:text-slate-400">最近更新：<time datetime={lastUpdated}>{lastUpdated}</time></p>}
  </div>
  {appearanceConfig.homeImage && <img src={appearanceConfig.homeImage} alt="" class="mt-6 max-h-48 w-full rounded-md object-cover" />}
</section>
