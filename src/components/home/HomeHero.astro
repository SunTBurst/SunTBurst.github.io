---
import type { HomeModel } from '../../utils/homeModel';

interface Props {
  identity: HomeModel['identity'];
  lastUpdated: string;
}

const { identity, lastUpdated } = Astro.props;
---

<section id="identity" aria-labelledby="identity-title" class="animate-card-entrance opacity-0 border-4 border-[#0284c7] bg-[#e0f2fe] p-5 shadow-[6px_6px_0_0_#0284c7] sm:p-8 dark:bg-slate-800">
  <p class="text-xs font-black tracking-[0.18em] text-[#0369a1]">PERSONAL PORTAL</p>
  <h1 id="identity-title" class="mt-3 break-words text-4xl font-black tracking-tight text-[#075985] sm:text-6xl dark:text-[#bae6fd]">{identity.name}</h1>
  <p class="mt-4 max-w-2xl text-base font-bold leading-7 text-slate-700 dark:text-slate-200">{identity.tagline}</p>
  <p class="mt-4 text-sm font-bold text-slate-600 dark:text-slate-300">最近更新：{lastUpdated}</p>
  <nav aria-label="首页主要入口" class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
    <a href="/start" class="min-h-[44px] border-2 border-[#0284c7] bg-[#fde68a] px-4 py-2 text-center text-sm font-black text-[#075985] shadow-[3px_3px_0_0_#0284c7] transition hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:translate-y-0">开始探索</a>
    <a href="/knowledge" class="min-h-[44px] border-2 border-[#0284c7] bg-white px-4 py-2 text-center text-sm font-black text-[#075985] shadow-[3px_3px_0_0_#0284c7] transition hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:translate-y-0 dark:bg-slate-700 dark:text-[#bae6fd]">进入知识地图</a>
    <a href="/ai" class="min-h-[44px] border-2 border-[#0284c7] bg-[#fce7f3] px-4 py-2 text-center text-sm font-black text-[#075985] shadow-[3px_3px_0_0_#0284c7] transition hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:translate-y-0">了解 AI 导览</a>
  </nav>
</section>
