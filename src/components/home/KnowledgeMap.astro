---
import type { KnowledgeTopic } from '../../types/portal';

interface Props {
  topics: KnowledgeTopic[];
}

const { topics } = Astro.props;
---

<section id="knowledge-map" aria-labelledby="knowledge-map-title" class="mt-8 border-3 border-[#059669] bg-[#ecfdf5] p-5 shadow-[4px_4px_0_0_#059669] dark:bg-emerald-950/40">
  <p class="text-xs font-black tracking-[0.16em] text-emerald-700 dark:text-emerald-300">KNOWLEDGE MAP</p>
  <h2 id="knowledge-map-title" class="mt-1 text-2xl font-black text-emerald-900 dark:text-emerald-100">知识地图</h2>
  <ul class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-3">
    {topics.map((topic) => (
      <li class="min-w-0 border-2 border-emerald-700 bg-white p-3 dark:bg-slate-800">
        <h3 class="font-black text-emerald-900 dark:text-emerald-100">{topic.title}</h3>
        <p class="mt-2 text-sm font-bold leading-6 text-slate-700 dark:text-slate-200">{topic.description}</p>
        <p class="mt-3 text-xs font-black text-emerald-700 dark:text-emerald-300">{topic.status}</p>
      </li>
    ))}
  </ul>
</section>
