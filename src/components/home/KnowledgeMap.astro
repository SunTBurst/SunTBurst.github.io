---
import type { KnowledgeTopic } from '../../types/portal';

interface Props {
  topics: KnowledgeTopic[];
}

const { topics } = Astro.props;
const statusLabels = {
  mapping: '正在绘制',
  growing: '持续生长',
  established: '已有体系',
} as const;
---

<section id="knowledge-map" aria-labelledby="knowledge-map-title" class="mt-8 border-3 border-[#059669] bg-[#ecfdf5] p-5 shadow-[4px_4px_0_0_#059669] dark:bg-emerald-950/40">
  <p class="text-xs font-black tracking-[0.16em] text-emerald-700 dark:text-emerald-300">KNOWLEDGE MAP</p>
  <h2 id="knowledge-map-title" class="mt-1 text-2xl font-black text-emerald-900 dark:text-emerald-100">知识地图</h2>
  <ul class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-3">
    {topics.map((topic) => (
      <li class="min-w-0 border-2 border-emerald-700 bg-white dark:bg-slate-800">
        <a href={`/topics/${encodeURIComponent(topic.slug)}`} data-knowledge-topic={topic.slug} class="group flex min-h-[156px] flex-col p-3 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-emerald-500/40">
          <h3 class="font-black text-emerald-900 underline decoration-2 underline-offset-4 group-hover:text-emerald-700 dark:text-emerald-100">{topic.title}</h3>
          <p class="mt-2 grow text-sm font-bold leading-6 text-slate-700 dark:text-slate-200">{topic.description}</p>
          <p class="mt-3 text-xs font-black text-emerald-700 dark:text-emerald-300">{statusLabels[topic.status]} →</p>
        </a>
      </li>
    ))}
  </ul>
</section>
