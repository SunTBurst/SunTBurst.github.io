---
import type { EnvironmentPreviewItem } from '../../utils/homeModel';

interface Props {
  items: EnvironmentPreviewItem[];
}

const { items } = Astro.props;
---

<section id="environment" aria-labelledby="environment-title" class="mt-8 border-3 border-slate-500 bg-slate-100 p-5 shadow-[4px_4px_0_0_#475569] dark:bg-slate-800">
  <p class="text-xs font-black tracking-[0.16em] text-slate-600 dark:text-slate-300">ENVIRONMENT PREVIEW</p>
  <h2 id="environment-title" class="mt-1 text-2xl font-black text-slate-800 dark:text-slate-100">环境预览</h2>
  <ul class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-5">
    {items.map((item) => (
      <li class="min-w-0 border-2 border-slate-500 bg-white p-3 dark:bg-slate-900">
        <h3 class="font-black text-slate-800 dark:text-slate-100">{item.title}</h3>
        <p class="mt-2 text-sm font-bold leading-6 text-slate-600 dark:text-slate-300">{item.preview}</p>
      </li>
    ))}
  </ul>
</section>
