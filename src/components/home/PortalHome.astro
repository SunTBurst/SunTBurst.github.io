---
import type { HomeModel } from '../../utils/homeModel';
import ActivityStream from './ActivityStream.astro';
import HomeHero from './HomeHero.astro';

interface Props { model: HomeModel; }
const { model } = Astro.props;
---

<div aria-label="个人门户首页" class="mx-auto w-full max-w-4xl px-2 py-3 sm:px-4 sm:py-6">
  <HomeHero identity={model.identity} lastUpdated={model.lastUpdated} />
  <section id="recent-posts" aria-labelledby="recent-posts-title" class="mt-8 sm:mt-10">
    <div class="flex items-center justify-between gap-3">
      <h2 id="recent-posts-title" class="text-xl font-semibold text-[#075985] dark:text-[#bae6fd]">最近文章</h2>
      {model.posts.length > 0 && <a href="/posts" class="inline-flex min-h-[44px] items-center px-2 text-sm text-[#075985] underline underline-offset-4 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#0ea5e9]/40 dark:text-[#bae6fd]">全部文章 <span aria-hidden="true" class="ml-1">→</span></a>}
    </div>
    {model.posts.length > 0 ? (
      <slot name="recent-posts">
        <ul class="mt-3 grid gap-4">
          {model.posts.slice(0, 4).map((post) => (
            <li class="site-surface min-w-0 rounded-lg border border-[#0284c7]/20 px-4 py-4 sm:px-6 sm:py-5">
              <time datetime={post.updatedAt} class="text-xs text-slate-500 dark:text-slate-400">{post.updatedAt.slice(0, 10)}</time>
              <h3 class="mt-1 text-lg font-semibold leading-7">
                <a href={post.href} data-touch-target="recent-post" class="inline-flex min-h-[44px] min-w-0 max-w-full items-center break-all px-1 py-2 text-[#075985] decoration-[#0284c7]/50 underline-offset-4 transition hover:underline focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#0ea5e9]/40 motion-reduce:transition-none dark:text-[#bae6fd]">{post.title}</a>
              </h3>
              <p class="mt-1 text-sm leading-7 text-slate-600 dark:text-slate-300">{post.description}</p>
            </li>
          ))}
        </ul>
      </slot>
    ) : (
      <div class="site-surface mt-3 rounded-lg border border-dashed border-[#0284c7]/30 p-5">
        <p class="text-sm leading-7 text-slate-600 dark:text-slate-300">暂时没有公开文章，可以先看看随记，或了解这个空间。</p>
        <nav aria-label="暂无文章时的入口" class="mt-2 flex gap-5">
          <a href="/talks" class="inline-flex min-h-[44px] items-center text-sm text-[#075985] underline underline-offset-4 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#0ea5e9]/40 dark:text-[#bae6fd]">阅读随记</a>
          <a href="/about" class="inline-flex min-h-[44px] items-center text-sm text-[#075985] underline underline-offset-4 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#0ea5e9]/40 dark:text-[#bae6fd]">关于</a>
        </nav>
      </div>
    )}
  </section>
  {model.talks.length > 0 && <ActivityStream entries={model.talks.slice(0, 3)} title="最近随记" description="简短记录此刻的想法。" />}
</div>
