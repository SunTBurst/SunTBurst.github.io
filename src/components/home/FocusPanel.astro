---
interface Props {
  focus: string[];
}

const { focus } = Astro.props;
---

<section id="current-focus" aria-labelledby="current-focus-title" class="mt-8 border-3 border-[#d97706] bg-[#fffbeb] p-5 shadow-[4px_4px_0_0_#d97706] dark:bg-amber-950/40">
  <p class="text-xs font-black tracking-[0.16em] text-amber-700 dark:text-amber-300">CURRENT FOCUS</p>
  <h2 id="current-focus-title" class="mt-1 text-2xl font-black text-amber-900 dark:text-amber-100">当前关注</h2>
  <ul class="mt-4 grid gap-3 sm:grid-cols-2">
    {focus.map((item) => <li class="border-2 border-amber-700 bg-white p-3 text-sm font-bold leading-6 text-slate-700 dark:bg-slate-800 dark:text-slate-200">{item}</li>)}
  </ul>
</section>
