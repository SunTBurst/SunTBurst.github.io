---
import { siteConfig } from '../config/site';
const links = [
  { href: '/rss.xml', label: 'RSS' },
  { href: '/about', label: '关于' },
  { href: '/friends', label: '友链' },
  { href: '/privacy', label: '隐私' },
  { href: '/lab', label: '工具' },
  { href: '/write', label: '写作工具' },
];
---

<footer data-portal-footer class="mt-10 border-t border-[#0284c7]/20 px-4 py-6 text-slate-500 dark:text-slate-400 sm:px-6">
  <div class="mx-auto flex w-full max-w-4xl flex-col items-start justify-between gap-2 sm:flex-row sm:items-center">
    <p class="text-xs">© {new Date().getFullYear()} {siteConfig.author}</p>
    <nav aria-label="页尾链接" class="flex flex-wrap gap-x-4">
      {links.map((link) => <a href={link.href} data-footer-link class="inline-flex min-h-[44px] items-center text-sm text-[#075985] underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#0ea5e9]/40 dark:text-[#bae6fd]">{link.label}</a>)}
    </nav>
  </div>
</footer>
