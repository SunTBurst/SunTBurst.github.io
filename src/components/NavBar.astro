---
const { pathname } = Astro.url;
const links = [
  { href: '/', label: '首页' },
  { href: '/posts', label: '文章' },
  { href: '/tags', label: '标签' },
];
---

<nav class="fixed top-0 left-0 right-0 z-[100] bg-white dark:bg-slate-800 border-b-4 border-[#0284c7] px-3 py-2 sm:px-6 sm:py-3 shadow-[0px_4px_0px_0px_rgba(30,58,138,0.1)]" transition:name="navbar" transition:persist>
  <div class="max-w-[1440px] mx-auto flex items-center justify-between gap-3">
    <a href="/" class="flex items-center gap-2 text-[#0284c7] font-black tracking-widest text-sm sm:text-base">
      <span class="w-8 h-8 flex items-center justify-center bg-[#fde68a] border-2 border-[#0284c7] shadow-[2px_2px_0px_0px_#0284c7]">B</span>
      <span>博客</span>
    </a>
    <div class="flex items-center gap-1 sm:gap-2">
      {links.map((link) => (
        <a
          href={link.href}
          class={`px-2.5 py-1.5 border-2 border-[#0284c7] text-xs sm:text-sm font-black rounded-sm transition-colors ${pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href)) ? 'bg-[#0284c7] text-white' : 'text-[#0284c7] bg-[#fde68a] hover:bg-[#0ea5e9] hover:text-white'}`}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>
