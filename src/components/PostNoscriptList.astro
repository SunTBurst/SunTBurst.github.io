---
import type { PublicPostBrowseEntry } from '../utils/postBrowserCore';

interface Props {
  posts: PublicPostBrowseEntry[];
}

const { posts } = Astro.props;
---

<noscript data-post-noscript>
  <section aria-labelledby="posts-noscript-title" class="mt-6 border-3 border-[#0284c7] bg-[#f8fafc] p-4 dark:bg-slate-900">
    <h2 id="posts-noscript-title" class="text-xl font-black text-[#075985] dark:text-[#bae6fd]">全部公开文章</h2>
    <p class="mt-2 font-bold leading-7">当前浏览器未运行 JavaScript，以下清单直接提供全部公开文章链接。</p>
    {posts.length === 0 ? <p class="mt-3 font-bold">暂时没有公开文章。</p> : (
      <ul class="mt-3 grid gap-2">
        {posts.map((post) => (
          <li><a data-noscript-post href={post.href} class="flex min-h-[44px] min-w-0 max-w-full items-center break-all border-2 border-[#0284c7] bg-white px-3 font-black text-[#075985] underline dark:bg-slate-800 dark:text-[#bae6fd]">{post.title}</a></li>
        ))}
      </ul>
    )}
  </section>
</noscript>
