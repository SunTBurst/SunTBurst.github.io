---
import { ClientRouter } from 'astro:transitions';
import NavBar from '../components/NavBar.astro';
import PrefetchLinks from '../components/PrefetchLinks.svelte';
import '../index.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  categoryName?: string | null;
  tagName?: string | null;
  post?: { title: string; date: string; dateISO?: string; keywords?: string[] } | null;
  keywords?: string[] | null;
  isArticle?: boolean;
  hideFooter?: boolean;
}

const {
  title = '博客',
  description = '个人博客',
  image,
  keywords = [],
  post = null,
  isArticle = false,
  hideFooter = false,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={post ? 'article' : 'website'} />
    {image && <meta property="og:image" content={image} />}
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="bg-[#f8fafc] text-slate-800 dark:bg-slate-900 dark:text-slate-100">
    <NavBar />
    <div class={`flex min-h-screen flex-col pt-16 ${isArticle ? 'article-paper-shell' : ''}`}>
      <main id="main-content" class="flex-1 px-2 py-3 sm:px-6 sm:py-6 md:px-8 md:py-8">
        <div class="mx-auto w-full max-w-[1440px]">
          <slot />
        </div>
      </main>
      {!hideFooter && (
        <footer class="border-t-4 border-[#0284c7] bg-white px-4 py-5 text-center text-xs font-bold text-slate-500 dark:bg-slate-800 dark:text-slate-300">
          博客
        </footer>
      )}
    </div>
    <PrefetchLinks client:load />
  </body>
</html>
